# /etc/systemd/system/lerna-api.service
# Lerna Assessment Module — REST API
[Unit]
Description=Lerna Assessment API (FastAPI)
After=network.target

[Service]
Type=simple
User=lerna
Group=lerna
WorkingDirectory=/opt/lerna
EnvironmentFile=/opt/lerna/.env
ExecStart=/opt/lerna/.venv/bin/uvicorn app.api:app \
    --host 127.0.0.1 --port 8002 --workers 2
Restart=always
RestartSec=5

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/lerna/data

[Install]
WantedBy=multi-user.target
