# EDUnation Assessment Module — REUSE the existing project keys (no new ones)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

ASSESS_SECRET=            # python -c "import secrets;print(secrets.token_urlsafe(32))"
ASSESS_DB_URL=sqlite:///./data/assessment.db
ASSESS_LLM_TIMEOUT=90
ASSESS_MAX_UPLOAD_MB=25
ASSESS_EMBED_MODEL=gemini-embedding-001
ASSESS_EMBED_DIM=768
ASSESS_ALLOW_EXTERNAL_KNOWLEDGE=false
ASSESS_WEAKNESS_PCT=60
ASSESS_STRENGTH_PCT=80
ASSESS_EVIDENCE_TOP_K=4
OPENROUTER_FAST_MODEL=google/gemini-3.8-flash

# --- Deployment ---
# dev (default) | production — production enforces a strong ASSESS_SECRET
ASSESS_ENV=dev
